{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": { "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off", "noLabelWithoutControl": "off" },
      "suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "files": { "includes": ["src/**", "!src/api/schema.d.ts"] }
}
